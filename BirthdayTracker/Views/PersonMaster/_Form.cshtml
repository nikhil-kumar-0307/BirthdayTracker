@model BirthdayTracker.Models.PersonMaster
@using BirthdayTracker.Models

<div class="form-grid">

    <div class="form-group">
        @Html.LabelFor(m => m.Salutation)
        @Html.DropDownListFor(m => m.Salutation, new SelectList(PersonLists.Salutations, Model.Salutation), "-- None --")
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { placeholder = "Full name" })
        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Designation)
        @Html.TextBoxFor(m => m.Designation, new { list = "designationList", placeholder = "DM, SP, MLA, MP ..." })
        <datalist id="designationList">
            @foreach (var d in PersonLists.Designations)
            {
                <option value="@d"></option>
            }
        </datalist>
        @Html.ValidationMessageFor(m => m.Designation, "", new { @class = "field-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Category)
        @Html.DropDownListFor(m => m.Category, new SelectList(PersonLists.Categories, Model.Category), "-- Select category --")
        @Html.ValidationMessageFor(m => m.Category, "", new { @class = "field-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Organization)
        @Html.TextBoxFor(m => m.Organization, new { placeholder = "e.g. District Collectorate" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Area)
        @Html.TextBoxFor(m => m.Area, new { placeholder = "District or constituency" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.DateOfBirth)
        @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { type = "date" })
        @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "field-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Gender)
        @Html.DropDownListFor(m => m.Gender, new SelectList(new[] { "Male", "Female", "Other" }, Model.Gender), "-- Select --")
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.MobileNo)
        @Html.TextBoxFor(m => m.MobileNo, new { placeholder = "10 digit mobile" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.OfficePhone)
        @Html.TextBoxFor(m => m.OfficePhone)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { type = "email" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-error" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.PaName)
        @Html.TextBoxFor(m => m.PaName)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.PaMobile)
        @Html.TextBoxFor(m => m.PaMobile)
    </div>

    <div class="form-group full">
        @Html.LabelFor(m => m.Address)
        @Html.TextBoxFor(m => m.Address, new { placeholder = "Residence / office address" })
    </div>

    <div class="form-group full">
        @Html.LabelFor(m => m.Remarks)
        @Html.TextAreaFor(m => m.Remarks, 3, 20, new { placeholder = "Any notes (optional)" })
    </div>
</div>